<mxfile host="app.diagrams.net"><diagram id="arch" name="Current architecture"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" value="CargoTracker — current package architecture (dependencies verified from imports)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;INTERFACES  (org.eclipse.cargotracker.interfaces)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Web / JSF: Booking, CargoDetails, ListCargo, Track&lt;br&gt;Facade: BookingServiceFacade, DefaultBookingServiceFacade, *DtoAssembler&lt;br&gt;REST: HandlingReportService &amp;nbsp;|&amp;nbsp; SSE: RealtimeCargoTrackingService&lt;br&gt;Batch: UploadDirectoryScanner, EventItemReader, EventItemWriter&lt;br&gt;HandlingEventRegistrationAttempt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="640" height="170" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;APPLICATION  (org.eclipse.cargotracker.application)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;BookingService / DefaultBookingService&lt;br&gt;HandlingEventService / DefaultHandlingEventService&lt;br&gt;CargoInspectionService / DefaultCargoInspectionService&lt;br&gt;ApplicationEvents &amp;nbsp;|&amp;nbsp; util: ApplicationSettings, DateConverter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="640" height="150" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;DOMAIN  (org.eclipse.cargotracker.domain)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;model.cargo: Cargo, Itinerary, Leg, RouteSpecification, Delivery, CargoRepository&lt;br&gt;model.handling: HandlingEvent, HandlingEventFactory, HandlingEventRepository&lt;br&gt;model.voyage: Voyage, CarrierMovement, VoyageRepository&lt;br&gt;model.location: Location, UnLocode, LocationRepository&lt;br&gt;service: RoutingService&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="640" height="190" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;INFRASTRUCTURE  (…infrastructure)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;persistence.jpa: JpaCargoRepository, JpaHandlingEventRepository, JpaLocationRepository, JpaVoyageRepository&lt;br&gt;messaging.jms: JmsApplicationEvents, *Consumer (5 MDBs)&lt;br&gt;routing: ExternalRoutingService&lt;br&gt;events.cdi: @CargoUpdated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450;arcSize=4;" vertex="1" parent="1"><mxGeometry x="780" y="300" width="330" height="260" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;PATHFINDER  (org.eclipse.pathfinder)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;api: GraphTraversalService (@Path /graph-traversal), TransitPath, TransitEdge&lt;br&gt;internal: GraphDao&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=4;" vertex="1" parent="1"><mxGeometry x="780" y="620" width="330" height="130" as="geometry"/></mxCell><mxCell id="e8" value="calls use cases" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="entities, repositories (DTO assemblers, Track)" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="uses model + repositories" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="implements repositories, RoutingService" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b6" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="MDBs call services; implements ApplicationEvents" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b6" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="REST client + TransitPath/TransitEdge" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="imports HandlingEventRegistrationAttempt" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#cc0000;fontSize=10;fontColor=#cc0000;labelBackgroundColor=#ffffff;dashed=1;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b4" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="uses HandlingEventRegistrationAttempt" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#cc0000;fontSize=10;fontColor=#cc0000;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="b6" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="imports @CargoUpdated" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#cc0000;fontSize=10;fontColor=#cc0000;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t17" value="Legend&#10;■ solid arrow = expected dependency&#10;■ red dashed arrow = dependency against the layer direction (refactoring candidate)&#10;Domain and Pathfinder import nothing from other layers." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="60" width="330" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>